  "reviews": [
    {
      "author": "Yolanda Vg",
      "authorPhoto": "https://lh3.googleusercontent.com/a-/ALV-UjXbHAHdhkDTQQjIW9Ce-lIBxAHRaxTr4j9zJNhgzmr90w3GAig=s128-c0x00000000-cc-rp-mo",
      "authorUri": "https://www.google.com/maps/contrib/108222958737928620990/reviews",
      "rating": 5,
      "text": "Todo muy rico y el personal muy amable. Un ambiente muy agradable. Hemos repetido y lo seguiremos haciendo. Muy buen precio.",
